# App 源码随仓库开源；只排除构建中间物与依赖
app/android/
app/www/
app/node_modules/
app/icons-gen/
# 桌面壳打包用：skill/ 的构建期副本（真源在仓库根 skill/，由 sync_app.py 同步）
app/skill/
dsh-plugin/assets/

# 数据与密钥
node_modules/
dist/
.env*
*.local
data/

# 系统
.DS_Store
Thumbs.db

# 部署暂存目录
.pages-dist/
__pycache__/

# wrangler 本地缓存（含账户信息，不入仓）
.wrangler/

# 安卓壳构建产物（CI 现场生成）
/www/
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
*.apk

# README 界面截图页（由 scripts/preview_shots.mjs 生成，不入库；PNG 成品在 docs/assets/）
docs/shots/

# 宣传视频的中间产物（几十 MB 的素材与渲染帧，不入库）
docs/launch-video/
